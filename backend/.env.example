PORT=3000
MONGODB_URI=mongodb://localhost:27017/screensync
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=24h
HEARTBEAT_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=10000
SYNC_BUFFER_MS=2000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=500

# Instagram automation remains disabled until this integration is configured.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-screensync-host/api/instagram/oauth/callback
META_GRAPH_VERSION=
META_OAUTH_SCOPES=instagram_basic,pages_show_list,pages_read_engagement
INSTAGRAM_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
INSTAGRAM_SCHEDULER_SECRET=replace_with_a_different_long_random_secret
FRONTEND_BASE_URL=https://your-screensync-host/

# Required for durable imported media. Use a private S3 bucket; the TV client
# streams objects through the ScreenSync backend and never receives S3 keys.
INSTAGRAM_OBJECT_STORAGE_BUCKET=
INSTAGRAM_OBJECT_STORAGE_REGION=
# Optional for S3-compatible providers (e.g. R2); leave blank for AWS S3.
INSTAGRAM_OBJECT_STORAGE_ENDPOINT=
INSTAGRAM_OBJECT_STORAGE_FORCE_PATH_STYLE=false
# AWS SDK credential chain is used (Render environment credentials or IAM role).
TESSERACT_LANGUAGES=eng
INSTAGRAM_MAX_MEDIA_BYTES=104857600
INSTAGRAM_MAX_IMAGE_BYTES=26214400
